rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(roomId) {
      return request.auth != null &&
        request.auth.token.justelle_member == true &&
        request.auth.token.justelle_room == roomId &&
        firestore.exists(/databases/(default)/documents/rooms/$(roomId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.uids;
    }
    match /rooms/{roomId}/media/{fileId} {
      allow get: if member(roomId);
      allow list: if false;
      allow create: if resource == null && member(roomId) &&
        fileId.matches('[a-f0-9-]{36}(-preview)?') &&
        request.resource.size > 0 && request.resource.size <= 12582912 &&
        request.resource.contentType.matches('image/(png|jpeg|heic|heif)') &&
        request.resource.metadata.author_uid == request.auth.uid &&
        request.resource.metadata.attachment_id is string &&
        request.resource.metadata.attachment_id.matches('[a-f0-9-]{36}') &&
        request.resource.metadata.role in ['original','preview'];
      allow update, delete: if false;
    }
    match /{other=**} {allow read, write: if false;}
  }
}
